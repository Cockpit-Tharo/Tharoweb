# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js & turbopack
/.next/
/out/
/.turbo

# production
/build
/dist

# misc & OS
.DS_Store
*.pem
Thumbs.db
ehthumbs.db
[Dd]esktop.ini

# debug & logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (allow .env.example if created)
.env*
!.env.example

# vercel
.vercel

# ide & editors
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
*.swp
*.swo

# typescript
*.tsbuildinfo
next-env.d.ts

# agents & skills
.agents/
skills-lock.json
